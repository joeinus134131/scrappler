// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  passwordHash  String   @map("password_hash")
  name          String
  role          String   @default("user")
  preferences   Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  jobs          ScrapeJob[]
  categories    Category[]
  exports       ExportHistory[]
  apiCredentials ApiCredential[]

  @@map("users")
}

model Platform {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  iconUrl   String?  @map("icon_url")
  isActive  Boolean  @default(true) @map("is_active")
  config    Json     @default("{}")

  jobs      ScrapeJob[]
  results   ScrapeResult[]

  @@map("platforms")
}

model ScrapeJob {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid @map("user_id")
  platformId     Int       @map("platform_id")
  jobType        String    @map("job_type")
  status         String    @default("pending")
  parameters     Json      @default("{}")
  filters        Json      @default("{}")
  priority       Int       @default(0)
  retryCount     Int       @default(0) @map("retry_count")
  maxRetries     Int       @default(3) @map("max_retries")
  cronExpression String?   @map("cron_expression")
  isRecurring    Boolean   @default(false) @map("is_recurring")
  scheduledAt    DateTime? @map("scheduled_at")
  startedAt      DateTime? @map("started_at")
  completedAt    DateTime? @map("completed_at")
  errorMessage   String?   @map("error_message")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       Platform  @relation(fields: [platformId], references: [id], onDelete: Restrict)
  results        ScrapeResult[]
  sessions       ScrapeSession[]

  @@map("scrape_jobs")
}

model ScrapeResult {
  id               String    @id @default(uuid()) @db.Uuid
  jobId            String    @db.Uuid @map("job_id")
  platformId       Int       @map("platform_id")
  contentType      String    @map("content_type")
  externalId       String?   @map("external_id")
  rawData          Json      @map("raw_data")
  normalizedData   Json      @map("normalized_data")
  contentText      String?   @map("content_text") @db.Text
  authorUsername   String?   @map("author_username")
  authorId         String?   @map("author_id")
  likesCount       Int       @default(0) @map("likes_count")
  commentsCount    Int       @default(0) @map("comments_count")
  sharesCount      Int       @default(0) @map("shares_count")
  viewsCount       Int       @default(0) @map("views_count")
  publishedAt      DateTime? @map("published_at")
  mediaUrl         String?   @map("media_url")
  permalink        String?
  sentiment        String?
  sentimentScore   Float?    @map("sentiment_score")
  scrapedAt        DateTime  @default(now()) @map("scraped_at")

  job              ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  platform         Platform  @relation(fields: [platformId], references: [id], onDelete: Restrict)
  categories       Category[]

  @@map("scrape_results")
}

model Category {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid @map("user_id")
  name      String
  color     String?
  icon      String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  results   ScrapeResult[]

  @@map("categories")
}

model ProxyPool {
  id               Int       @id @default(autoincrement())
  host             String
  port             Int
  protocol         String    @default("http")
  username         String?
  password         String?
  country          String?
  isActive         Boolean   @default(true) @map("is_active")
  failCount        Int       @default(0) @map("fail_count")
  avgResponseMs    Float?    @map("avg_response_ms")
  lastUsedAt       DateTime? @map("last_used_at")
  lastCheckedAt    DateTime? @map("last_checked_at")

  sessions         ScrapeSession[]

  @@map("proxy_pool")
}

model ScrapeSession {
  id                 String    @id @default(uuid()) @db.Uuid
  jobId              String    @db.Uuid @map("job_id")
  proxyId            Int?      @map("proxy_id")
  browserFingerprint String?   @map("browser_fingerprint")
  status             String
  itemsScraped       Int       @default(0) @map("items_scraped")
  errorsCount        Int       @default(0) @map("errors_count")
  startedAt          DateTime  @default(now()) @map("started_at")
  endedAt            DateTime? @map("ended_at")
  logs               Json      @default("[]")

  job                ScrapeJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proxy              ProxyPool? @relation(fields: [proxyId], references: [id], onDelete: SetNull)

  @@map("scrape_sessions")
}

model ExportHistory {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid @map("user_id")
  format         String
  filename       String
  recordCount    Int       @map("record_count")
  filtersApplied Json      @map("filters_applied")
  downloadUrl    String    @map("download_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("export_history")
}

model ApiCredential {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid @map("user_id")
  provider  String   // "rapidapi", "apify"
  apiKey    String   @map("api_key")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_credentials")
  @@unique([userId, provider])
}
